class Solution:
    def subarraysDivByK(self, nums: List[int], k: int) -> int:
        remainderFrequency = defaultdict(int)
        remainderFrequency[0] = 1
        
        result = prefixSum = 0
        for n in nums:
            prefixSum += n
            remainder = prefixSum % k
            result += remainderFrequency[remainder]
            
            remainderFrequency[remainder] += 1
        return result 
